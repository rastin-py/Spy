# Copy to .env. Everything has a working default; nothing here is a secret yet.
SPY_LOG_FORMAT=text
SPY_LOG_LEVEL=INFO
SPY_RELEASE=dev

# Blank switches the /admin pages off entirely.
SPY_ADMIN_TOKEN=

# SQLite needs no container. Set a Postgres URL in production.
SPY_DATABASE_URL=sqlite:///./spy.db
